# Postgres კავშირი
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# User.personalNumber/phoneNumber-ის (at-rest) დაშიფვრის გასაღები — ზუსტად 64 hex
# სიმბოლო (32 ბაიტი). სავალდებულოა, აპლიკაცია ბუთზევე ჩავარდება მის გარეშე
# (იხ. src/common/utils/encryption.util.ts, src/main.ts). გენერაცია: `openssl rand -hex 32`.
# ⚠️ ცვლილება ამ გასაღების ამ ველების უკვე დაშიფრულ მონაცემებს გაშიფვრადს ხდის —
# გასაღების როტაცია მოითხოვს არსებული ჩანაწერების ხელახლა დაშიფვრას.
ENCRYPTION_KEY=

# Gmail (password-reset ემეილებისთვის, EmailService)
EMAIL_USER=
EMAIL_PASS=

# ფრონტენდის მისამართი (reset-password ბმულისთვის)
FRONTEND_URL=

# Google OAuth Client ID — POST /auth/google-ზე მიღებული ID Token-ის (aud claim)
# ვერიფიკაციისთვის (იხ. AuthService.googleLogin). ეს არის ის Client ID, რომელსაც
# ფრონტენდი იყენებს Google Identity Services-ში (client secret არ სჭირდება).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reverse proxy-ის (nginx/CDN) უკან გაშვებისას აუცილებელია — თორემ per-IP
# rate limit (ThrottlerGuard) ყველა მოთხოვნას proxy-ის ერთი IP-ით დაითვლის და
# login-ის 5/წთ ლიმიტი მთელ საიტს დაბლოკავს (იხ. src/main.ts).
# მნიშვნელობა: proxy-ების რაოდენობა (მაგ. 1) ან `true`.
# ⚠️ proxy-ის გარეშე ცარიელი დარჩეს — თორემ X-Forwarded-For-ის გაყალბებით
# ლიმიტს გვერდი აუვლიან.
TRUST_PROXY=

# სავალდებულოა — ცარიელი/დაუშვებელი მნიშვნელობით ბუთი განზრახ ჩავარდება
# (იხ. src/main.ts), რომ production ბაზაზე შემთხვევით synchronize:true არ
# გაეშვას. ლოკალურ dev-ში: development. production-ში (production): synchronize
# გამოირთვება, migrationsRun ავტომატურად ბუთზე გაეშვება (იხ. app.module.ts).
NODE_ENV=development

# CORS-ის დასაშვები origin-ები, მძიმით გამოყოფილი (production დომენებისთვის).
# თუ ცარიელია, გამოიყენება ლოკალური localhost origin-ების ნაგულისხმევი სია.
CORS_ORIGINS=

# სერვერის მოსასმენი პორტი (default 5000)
PORT=

# გადახდის პროვაიდერი: "mock" (default, კომპანიის რეგისტრაციამდე — checkout
# ნაკადი ხელოვნურად სრულდება) ან "bog" (რეალური BOG, საჭიროებს ქვემოთ BOG_* ცვლადებს)
PAYMENT_PROVIDER=
# ბექენდის საჯარო/ლოკალური მისამართი — mock პროვაიდერის auto-complete ბმულისთვის
BACKEND_URL=

# BOG (Bank of Georgia) e-commerce გადახდები — src/payments/providers/bog-payment.provider.ts
# BOG_BASE_URL: production https://api.bog.ge; sandbox-ის ცალკე ჰოსტი დაადასტურეთ
# https://api.bog.ge/docs/en/sandbox-ზე ჩართვამდე — ცარიელი დარჩება production-ზე დეფოლტდება.
BOG_BASE_URL=
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# BOG-ის callback endpoint-ის საჯარო (არა localhost) მისამართი, მაგ.
# https://<public-host>/payments/callback/bog — BOG-მა უნდა შეძლოს POST-ის გაგზავნა აქ.
BOG_CALLBACK_URL=
# BOG-ის RSA public key (callback-ის Callback-Signature ვერიფიკაციისთვის) —
# PEM შიგთავსი უშუალოდ ამ ცვლადში, არასდროს კომიტში inline კოდში.
BOG_PUBLIC_KEY=

# verify.ge — მობილურის ნომრის SMS-ით (OTP) ვერიფიკაცია რეგისტრაციისას
# (src/otp/otp.service.ts). VERIFY_GE_BASE_URL ცარიელი დარჩება
# https://api.verify.ge/api/v1-ზე დეფოლტდება.
# ⚠️ verify.ge-ს Free tier-ზე კოდი მხოლოდ ანგარიშზე რეგისტრირებულ (ტესტ)
# ნომერზე იგზავნება — production-ისთვის საჭიროა Starter ტარიფი (https://verify.ge/en/pricing).
VERIFY_GE_API_KEY=
VERIFY_GE_BASE_URL=

# false, თუ დროებით გვინდა SMS-ვერიფიკაციის გამორთვა (მაგ. verify.ge-ს Free
# tier-ის ტესტ-ნომრის შეზღუდვის გამო ლოკალურ dev-ში) — ცარიელი/true = ჩართულია.
PHONE_VERIFICATION_ENABLED=
