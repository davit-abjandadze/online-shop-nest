# Postgres კავშირი
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Gmail (password-reset ემეილებისთვის, EmailService)
EMAIL_USER=
EMAIL_PASS=

# ფრონტენდის მისამართი (reset-password ბმულისთვის)
FRONTEND_URL=

# production-ში (NODE_ENV=production): synchronize გამოირთვება, migrationsRun
# ავტომატურად ბუთზე გაეშვება (იხ. app.module.ts). ლოკალურ dev-ში ეს ცვლადი
# ცარიელი დარჩეს — ძველებურად synchronize:true იმუშავებს.
NODE_ENV=

# CORS-ის დასაშვები origin-ები, მძიმით გამოყოფილი (production დომენებისთვის).
# თუ ცარიელია, გამოიყენება ლოკალური localhost origin-ების ნაგულისხმევი სია.
CORS_ORIGINS=

# სერვერის მოსასმენი პორტი (default 5000)
PORT=

# გადახდის პროვაიდერი: "mock" (default, კომპანიის რეგისტრაციამდე — checkout
# ნაკადი ხელოვნურად სრულდება) ან "bog" (რეალური BOG, საჭიროებს ქვემოთ BOG_* ცვლადებს)
PAYMENT_PROVIDER=
# ბექენდის საჯარო/ლოკალური მისამართი — mock პროვაიდერის auto-complete ბმულისთვის
BACKEND_URL=

# BOG (Bank of Georgia) e-commerce გადახდები — src/payments/providers/bog-payment.provider.ts
# BOG_BASE_URL: production https://api.bog.ge; sandbox-ის ცალკე ჰოსტი დაადასტურეთ
# https://api.bog.ge/docs/en/sandbox-ზე ჩართვამდე — ცარიელი დარჩება production-ზე დეფოლტდება.
BOG_BASE_URL=
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# BOG-ის callback endpoint-ის საჯარო (არა localhost) მისამართი, მაგ.
# https://<public-host>/payments/callback/bog — BOG-მა უნდა შეძლოს POST-ის გაგზავნა აქ.
BOG_CALLBACK_URL=
# BOG-ის RSA public key (callback-ის Callback-Signature ვერიფიკაციისთვის) —
# PEM შიგთავსი უშუალოდ ამ ცვლადში, არასდროს კომიტში inline კოდში.
BOG_PUBLIC_KEY=

# verify.ge — მობილურის ნომრის SMS-ით (OTP) ვერიფიკაცია რეგისტრაციისას
# (src/otp/otp.service.ts). VERIFY_GE_BASE_URL ცარიელი დარჩება
# https://api.verify.ge/api/v1-ზე დეფოლტდება.
# ⚠️ verify.ge-ს Free tier-ზე კოდი მხოლოდ ანგარიშზე რეგისტრირებულ (ტესტ)
# ნომერზე იგზავნება — production-ისთვის საჭიროა Starter ტარიფი (https://verify.ge/en/pricing).
VERIFY_GE_API_KEY=
VERIFY_GE_BASE_URL=

# false, თუ დროებით გვინდა SMS-ვერიფიკაციის გამორთვა (მაგ. verify.ge-ს Free
# tier-ის ტესტ-ნომრის შეზღუდვის გამო ლოკალურ dev-ში) — ცარიელი/true = ჩართულია.
PHONE_VERIFICATION_ENABLED=
